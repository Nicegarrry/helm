# Copy to ~/.helm/.env (or $HELM_HOME/.env). Never commit the real file.
# The real environment wins over this file. `helm env` shows which are set.

# Pi lane, OpenCode Go subscription: models opencode-go/<model>. Key from opencode.ai/auth.
OPENCODE_API_KEY=
# Pi lane, OpenRouter (pay per token, the fallback): models openrouter/<vendor>/<model>.
OPENROUTER_API_KEY=
# Optional extra Pi providers, used only when a brief names one of their models.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Codex lane uses the Codex CLI's own ChatGPT login (`codex login`); no key here.
# HELM_CODEX_BIN=~/.local/bin/codex
# GitHub uses the gh CLI's own login (`gh auth login`); GH_TOKEN only if you need to override it.
# GH_TOKEN=

# Shell command run by `helm wait` with the event line in $HELM_EVENT, e.g. a Discord webhook:
# HELM_NOTIFY=curl -s -H 'Content-Type: application/json' -d "{\"content\":\"$HELM_EVENT\"}" "$DISCORD_WEBHOOK"
# HELM_HOME=~/.helm
# Runs, worktrees and worker caches (TMPDIR, npm/pnpm, XDG cache). Default: HELM_HOME. helm run
# refuses to start when this is set but missing, e.g. an external drive that is unplugged.
# HELM_WORK=/Volumes/T7/factory-scratch/helm

# Fleet dispatch thresholds in MiB. Low capacity waits; 0 disables the threshold.
# HELM_FLEET_MIN_MEMORY_MB=1024
# HELM_FLEET_MIN_DISK_MB=2048
